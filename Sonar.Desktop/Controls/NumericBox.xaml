<UserControl x:Class="Sonar.Controls.NumericBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Border x:Name="Box" Height="30" CornerRadius="7"
            Background="{StaticResource InputBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="ValueBox" Grid.Column="0"
                     Background="Transparent" BorderThickness="0"
                     Foreground="{StaticResource TextBrush}"
                     CaretBrush="{StaticResource AccentHoverBrush}"
                     SelectionBrush="{StaticResource AccentBrush}"
                     SelectionOpacity="0.4"
                     FontFamily="{StaticResource UiFont}" FontSize="12"
                     VerticalContentAlignment="Center"
                     Padding="8,0,2,0"
                     FocusVisualStyle="{x:Null}"
                     TextAlignment="Right"
                     LostFocus="OnValueBoxLostFocus"
                     PreviewKeyDown="OnValueBoxKeyDown"/>

            <TextBlock x:Name="SuffixText" Grid.Column="1" Text=""
                       Foreground="{StaticResource TextMutedBrush}" FontSize="10.5"
                       VerticalAlignment="Center" Margin="2,0,3,0" IsHitTestVisible="False"/>

            <StackPanel Grid.Column="2" Width="15" Margin="0,3,3,3">
                <RepeatButton x:Name="UpButton" Height="11" Delay="350" Interval="60"
                              Click="OnUpClick" Cursor="Hand" Focusable="False">
                    <RepeatButton.Template>
                        <ControlTemplate TargetType="RepeatButton">
                            <Border x:Name="bg" Background="Transparent" CornerRadius="3">
                                <TextBlock Text="▲" FontSize="6" Foreground="{StaticResource TextDimBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </RepeatButton.Template>
                </RepeatButton>
                <RepeatButton x:Name="DownButton" Height="11" Delay="350" Interval="60"
                              Click="OnDownClick" Cursor="Hand" Focusable="False">
                    <RepeatButton.Template>
                        <ControlTemplate TargetType="RepeatButton">
                            <Border x:Name="bg" Background="Transparent" CornerRadius="3">
                                <TextBlock Text="▼" FontSize="6" Foreground="{StaticResource TextDimBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </RepeatButton.Template>
                </RepeatButton>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
